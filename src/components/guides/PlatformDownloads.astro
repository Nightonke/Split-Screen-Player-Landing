---
import { appFacts } from "@config/appFacts";
import { FaApple, FaGooglePlay } from "react-icons/fa";
import { pageChrome } from "@/i18n/chrome";
import { articleChrome } from "@/i18n/articleChrome";
import type { Locale } from "@/i18n/locales";
interface Props { locale?: Locale; primary?: "ios" | "android"; }
const { primary = "ios", locale = "zh-Hans" } = Astro.props;
const copy = articleChrome[locale];
const download = pageChrome[locale].downloadFree;
const links = [
  { platform: "ios", href: appFacts.appStoreUrl, label: copy.iosLabel, store: "App Store", qr: "/assets/app-store-qr.png", Icon: FaApple },
  { platform: "android", href: appFacts.googlePlayUrl, label: copy.androidLabel, store: "Google Play", qr: "/assets/google-play-qr.png", Icon: FaGooglePlay },
].sort((a, b) => Number(b.platform === primary) - Number(a.platform === primary));
---
<div class="platform-downloads" aria-label={copy.choosePlatform}>
  {links.map(({ href, label, store, qr, Icon }) => (
    <a class="button button-dark" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${store} · ${download} · ${label}`}>
      <span class="platform-download-icon"><Icon aria-hidden="true" /></span>
      <span class="platform-download-copy">{label}<small><span>{store}</span><span class="platform-download-separator"> · </span><span>{download}</span></small></span>
      <img class="platform-download-qr" src={qr} width="84" height="84" alt={`${copy.scan} · ${store} · ${label}`} />
    </a>
  ))}
</div>
<style>
  .platform-downloads { display: grid; gap: 12px; width: min(100%, 360px); }
  .platform-downloads a { display: grid; grid-template-columns: 24px minmax(0, 1fr) 84px; width: 100%; gap: 12px; padding: 12px; text-align: start; }
  .platform-download-icon { display: flex; align-items: center; justify-content: center; }
  .platform-download-copy { display: grid; gap: 6px; line-height: 1.4; font-size: .95rem; }
  .platform-downloads small { font-size: .7rem; font-weight: 500; opacity: .85; }
  .platform-download-qr { width: 84px; height: 84px; border-radius: 6px; background: white; }
  @media (max-width: 680px) {
    .platform-downloads { width: min(100%, 500px); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .platform-downloads a { min-width: 0; grid-template-columns: 20px minmax(0, 1fr); grid-template-rows: 1fr auto; align-items: start; gap: 10px 6px; padding: 12px 10px; }
    .platform-download-icon { padding-block-start: 1px; }
    .platform-download-icon svg { width: 20px; height: 20px; }
    .platform-download-copy { min-width: 0; gap: 4px; font-size: .85rem; overflow-wrap: anywhere; }
    .platform-downloads small { line-height: 1.5; }
    .platform-downloads small > span { display: block; }
    .platform-downloads small > .platform-download-separator { display: none; }
    .platform-download-qr { grid-column: 1 / -1; justify-self: center; }
  }
</style>

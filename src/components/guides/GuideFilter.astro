---
interface Props {
  name: "platform" | "topic";
  label: string;
  options: { value: string; label: string }[];
}

const { name, label, options } = Astro.props;
const id = `guide-filter-${name}`;
---

<div class="guide-filter" data-guide-filter={name}>
  <label id={`${id}-label`} for={id}>{label}</label>
  <select id={id} data-guide-platform={name === "platform" ? "" : undefined} data-guide-topic={name === "topic" ? "" : undefined}>
    {options.map(option => <option value={option.value}>{option.label}</option>)}
  </select>
  <button
    class="filter-trigger"
    type="button"
    id={`${id}-trigger`}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-options`}
    aria-labelledby={`${id}-label ${id}-value`}
    hidden
  >
    <span id={`${id}-value`} data-filter-value>{options[0].label}</span>
    <svg class="filter-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <ul class="filter-options" id={`${id}-options`} role="listbox" aria-labelledby={`${id}-label`} hidden>
    {options.map((option, index) => (
      <li role="option" aria-selected={index === 0 ? "true" : "false"} tabindex="-1" data-value={option.value}>
        <span>{option.label}</span>
        <svg class="filter-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-guide-filter]").forEach(root => {
    const select = root.querySelector("select")!;
    const trigger = root.querySelector("button")!;
    const label = root.querySelector("label")!;
    const value = root.querySelector<HTMLElement>("[data-filter-value]")!;
    const list = root.querySelector<HTMLElement>("[role=listbox]")!;
    const options = [...list.querySelectorAll<HTMLElement>("[role=option]")];
    let search = "";
    let lastTyped = 0;

    function syncSelection() {
      value.textContent = select.selectedOptions[0].textContent;
      options.forEach(option => option.setAttribute("aria-selected", String(option.dataset.value === select.value)));
    }

    function close(restoreFocus = false) {
      list.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      search = "";
      if (restoreFocus) trigger.focus({ preventScroll: true });
    }

    function focusOption(index: number) {
      options[index].focus({ preventScroll: true });
      options[index].scrollIntoView({ block: "nearest" });
    }

    function open(index = select.selectedIndex) {
      list.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      focusOption(index);
    }

    function choose(option: HTMLElement) {
      select.value = option.dataset.value!;
      select.dispatchEvent(new Event("change", { bubbles: true }));
      close(true);
    }

    function findByTyping(event: KeyboardEvent, current: number) {
      if (event.key.length !== 1 || event.ctrlKey || event.metaKey || event.altKey) return;
      event.preventDefault();
      const now = Date.now();
      search = (now - lastTyped > 600 ? "" : search) + event.key.toLocaleLowerCase();
      lastTyped = now;
      const prefix = [...search].every(char => char === search[0]) ? search[0] : search;
      for (let offset = 1; offset <= options.length; offset++) {
        const index = (current + offset) % options.length;
        if (options[index].textContent?.trim().toLocaleLowerCase().startsWith(prefix)) {
          open(index);
          break;
        }
      }
    }

    trigger.addEventListener("click", () => list.hidden ? open() : close());
    trigger.addEventListener("keydown", event => {
      if (["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
        event.preventDefault();
        open(event.key === "Home" ? 0 : event.key === "End" ? options.length - 1 : select.selectedIndex);
      } else if (event.key !== " ") {
        findByTyping(event, select.selectedIndex);
      }
    });

    list.addEventListener("keydown", event => {
      const current = options.indexOf(document.activeElement as HTMLElement);
      if (["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
        event.preventDefault();
        const index = event.key === "Home" ? 0 : event.key === "End" ? options.length - 1
          : Math.max(0, Math.min(options.length - 1, current + (event.key === "ArrowDown" ? 1 : -1)));
        focusOption(index);
      } else if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        if (current >= 0) choose(options[current]);
      } else if (event.key === "Escape") {
        event.preventDefault();
        close(true);
      } else if (event.key === "Tab") {
        // Let native tab order continue from the trigger, in either direction.
        close(true);
      } else {
        findByTyping(event, current);
      }
    });

    options.forEach(option => option.addEventListener("click", () => choose(option)));
    document.addEventListener("pointerdown", event => {
      if (!root.contains(event.target as Node)) close();
    });
    root.addEventListener("focusout", event => {
      if (!root.contains(event.relatedTarget as Node)) close();
    });
    select.addEventListener("change", syncSelection);
    syncSelection();
    select.hidden = true;
    trigger.hidden = false;
    label.htmlFor = trigger.id;
  });
</script>

<style>
  .guide-filter { position: relative; display: grid; grid-template-rows: auto 1fr; gap: 8px; min-width: 0; }
  label { color: var(--ink-soft); font-size: .875rem; font-weight: 600; }
  select, .filter-trigger { width: 100%; min-width: 0; min-height: 52px; border: 1.5px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--paper-strong); color: var(--ink); font: inherit; font-size: .9375rem; font-weight: 600; line-height: 1.4; }
  select { padding: 12px 44px 12px 16px; }
  .filter-trigger { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 12px 18px 12px 16px; text-align: start; cursor: pointer; transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease; }
  .filter-trigger:hover, .filter-trigger[aria-expanded="true"] { border-color: var(--ink); background: var(--paper-strong); box-shadow: 3px 3px 0 var(--paper-muted); }
  .filter-chevron { flex: 0 0 20px; transition: transform 160ms ease; }
  .filter-trigger span, [role="option"] span { min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .filter-trigger[aria-expanded="true"] .filter-chevron { transform: rotate(180deg); }
  .filter-options { position: absolute; z-index: 20; top: calc(100% + 8px); inset-inline-start: 0; width: max-content; min-width: 100%; max-width: min(320px, calc(100vw - 32px)); max-height: min(340px, 50vh); overflow-y: auto; overscroll-behavior: contain; margin: 0; padding: 6px; list-style: none; border: 1.5px solid var(--ink); border-radius: 18px; background: var(--paper-strong); box-shadow: 4px 4px 0 var(--paper-muted), 0 12px 28px rgba(23, 25, 22, .1); }
  [data-guide-filter="topic"] .filter-options { inset-inline-start: auto; inset-inline-end: 0; }
  [role="option"] { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 44px; padding: 10px; border-radius: 11px; color: var(--ink); font-size: .9375rem; line-height: 1.4; cursor: pointer; }
  [role="option"] + [role="option"] { margin-top: 2px; }
  [role="option"]:hover { background: var(--paper-muted); }
  [role="option"][aria-selected="true"] { background: var(--blue-soft); font-weight: 600; }
  [role="option"]:focus-visible { outline: 2px solid var(--blue-strong); outline-offset: -2px; }
  .filter-check { flex: 0 0 18px; visibility: hidden; }
  [aria-selected="true"] .filter-check { visibility: visible; }
  [hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .filter-trigger, .filter-chevron { transition: none; } }
</style>

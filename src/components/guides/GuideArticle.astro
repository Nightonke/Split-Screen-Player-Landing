---
import { type GuidePage } from "@/i18n/guides";
import { getGuideHub } from "@/i18n/guideHub";
import { getGuides } from "@/i18n/guideCatalog";
import { getMultiVideoRecommendations } from "@/i18n/multiVideoRecommendations";
import { articleChrome } from "@/i18n/articleChrome";
import { pageChrome } from "@/i18n/chrome";
import { localizedPath, isGuideLocale, type Locale } from "@/i18n/locales";
import { appFacts } from "@config/appFacts";
import { getClipDockGuide } from "@/i18n/clipDock";
import PlatformDownloads from "./PlatformDownloads.astro";
import GuideScreenshot from "./GuideScreenshot.astro";
import GuideNextSteps from "./GuideNextSteps.astro";
import "@/styles/guide-article.css";
interface Props { guide: GuidePage; locale: Locale; }
const { guide, locale } = Astro.props;
const article = guide.article!;
const relatedTool = getClipDockGuide(locale, guide.slug);
const copy = articleChrome[locale];
const chrome = pageChrome[locale];
const pages = getGuides(locale);
const isAndroid = guide.platform === "android";
const recommendations = isGuideLocale(locale) && (guide.slug === "play-multiple-videos-iphone-ipad" || guide.slug === "play-multiple-videos-android")
  ? getMultiVideoRecommendations(locale, pages, isAndroid ? "android" : "ios") : null;
// A partially translated catalog can link to the translated feature overview
// until the more detailed guide is available in this language.
function publishedFeatureLink(link: { label: string; path: string } | undefined) {
  if (!link?.path.startsWith("guides/")) return link;
  const slug = link.path.slice(7).split("#")[0];
  if (pages.some(page => page.slug === slug)) return link;
  const source = getGuides("en-US").find(page => page.slug === slug);
  // Illustrated sync tutorials inherit the generic player category; use the
  // synchronization overview for their introductory links.
  const feature = slug.startsWith("sync-videos-") ? "video-sync-comparison" : source?.relatedFeature;
  return feature ? { ...link, path: `features/${feature}` } : undefined;
}
const features = article.features.map((feature, index) => ({
  ...feature,
  link: publishedFeatureLink(feature.link ?? recommendations?.featureLinks[index]),
}));
const primaryStore = isAndroid ? appFacts.googlePlayUrl : appFacts.appStoreUrl;
const otherPlatform = pages.find(page => page.slug === guide.otherPlatformSlug);
const preferred = (guide.relatedSlugs ?? []).flatMap(slug => pages.filter(page => page.slug === slug));
const related = [...preferred, ...pages].filter((page, index, all) =>
  all.findIndex(item => item.slug === page.slug) === index &&
  page.slug !== guide.slug && page.slug !== guide.otherPlatformSlug &&
  (page.platform ?? "ios") === (guide.platform ?? "ios"),
).slice(0, 3);
---
<main id="main-content" class="ssp-guide-article site-shell">
  <nav class="detail-breadcrumb" aria-label={chrome.breadcrumbLabel}>
    <a href={localizedPath(locale)}>{chrome.homeLabel}</a>
    <a href={localizedPath(locale, "guides")}>{getGuideHub(locale).labels.guides}</a>
    <span aria-current="page">{guide.eyebrow}</span>
  </nav>
  <header class="article-guide-hero">
    <p class="eyebrow">{guide.eyebrow}</p>
    <h1>{guide.title}</h1>
    <p class="article-guide-lead">{guide.summary}</p>
    <div class="article-platform-links"><a class="text-link" href={primaryStore} target="_blank" rel="noopener noreferrer">{chrome.downloadFree} · {isAndroid ? "Google Play" : "App Store"}</a>{otherPlatform && <a class="text-link" href={localizedPath(locale, `guides/${otherPlatform.slug}`)}>{isAndroid ? copy.iosGuide : copy.androidGuide}</a>}</div>
    {guide.note && <p class="article-illustration-note">{guide.note}</p>}
  </header>
  <div class="article-guide-grid">
    <aside class="article-guide-toc">
      <p>{copy.toc}</p>
      <nav aria-label={copy.toc}>
        {guide.steps.map((step, index) => <a href={`#step-${index + 1}`}><span>{String(index + 1).padStart(2, "0")}</span>{step.title}</a>)}
        <a href="#more-possibilities"><span>＋</span>{copy.more}</a>
        <a href="#questions"><span>？</span>{copy.faq}</a>
        {recommendations && <a href="#next-guides"><span>↗</span>{recommendations.toc}</a>}
      </nav>
    </aside>
    <article class="article-guide-body">
      <p class="article-guide-answer">{guide.answer}</p>
      {guide.steps.map((step, index) => (
        <section id={`step-${index + 1}`} class:list={["article-guide-step", index % 2 === 1 && "article-guide-step--reverse", (!step.image || step.image.width > step.image.height) && "article-guide-step--wide"]}>
          <div class="article-guide-step-copy">
            <span class="article-guide-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h2>{step.title}</h2>
            <p>{step.description}</p>
            {step.detail && <p>{step.detail}</p>}
          </div>
          {step.image && <GuideScreenshot locale={locale} image={step.image} eager={index === 0} />}
        </section>
      ))}
      <section class="article-guide-more" id="more-possibilities">
        <p class="eyebrow">{copy.more}</p>
        <h2>{article.featuresHeading}</h2>
        <p>{article.featuresIntro}</p>
        <div class="article-guide-facts" aria-label={copy.more}>
          <div><strong>{appFacts.layoutCount}</strong><span>{copy.layouts}</span></div>
          <div><strong>{appFacts.maxVideos}</strong><span>{copy.videos}</span></div>
          <div><strong>{copy.customize}</strong><span>{copy.geometry}</span></div>
        </div>
        {features.map(feature => <section class="article-guide-feature">
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
          {feature.link && <a class="text-link" href={localizedPath(locale, feature.link.path)}>{feature.link.label}</a>}
        </section>)}
        {relatedTool && <aside class="article-tool-note">
          <p>{relatedTool.before}{relatedTool.separator}<a href={relatedTool.href}>{relatedTool.label}</a>{relatedTool.separator}{relatedTool.after}</p>
        </aside>}
      </section>
      <section class="article-guide-faq" id="questions">
        <h2>{copy.faq}</h2>
        {article.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </section>
      {recommendations && <GuideNextSteps locale={locale} recommendations={recommendations} />}
      <section class="article-guide-cta" aria-labelledby="article-download-title">
        <p class="eyebrow">Split Screen Player</p>
        <h2 id="article-download-title">{article.closingTitle}</h2>
        <p>{article.closingDescription}</p>
        <PlatformDownloads locale={locale} primary={isAndroid ? "android" : "ios"} />
      </section>
    </article>
  </div>
  {!recommendations && related.length > 0 && <section class="article-guide-related" aria-labelledby="related-guides-title">
    <h2 id="related-guides-title">{copy.related}</h2>
    <div>{related.map(page => <a href={localizedPath(locale, `guides/${page.slug}`)}><span>{page.eyebrow}</span><h3>{page.title}</h3><span>{copy.read} →</span></a>)}</div>
    <a class="text-link" href={localizedPath(locale, "guides")}>{chrome.viewAllGuides}</a>
  </section>}
</main>
<dialog class="article-guide-lightbox" aria-label={copy.enlarge}>
  <button type="button" class="article-guide-lightbox-close" aria-label={copy.close}>{copy.close} ×</button>
  <div class="article-guide-lightbox-content"></div>
</dialog>
<style>
  .article-tool-note {
    margin-top: 28px;
    padding: 20px 24px;
    border-inline-start: 3px solid var(--blue-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--paper-strong);
  }
  .article-tool-note p { margin: 0; }
  .article-tool-note a { text-decoration: underline; text-underline-offset: .2em; font-weight: 700; }
</style>
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".article-guide-lightbox");
  const content = dialog?.querySelector<HTMLElement>(".article-guide-lightbox-content");
  if (dialog && content) {
    const close = () => dialog.close();
    document.querySelectorAll<HTMLAnchorElement>("[data-guide-enlarge]").forEach(link => {
      link.addEventListener("click", event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const image = link.querySelector(".article-screenshot-image");
        if (!image) return;
        event.preventDefault();
        content.replaceChildren(image.cloneNode(true));
        dialog.showModal();
      });
    });
    dialog.querySelector("button")?.addEventListener("click", close);
    dialog.addEventListener("click", event => { if (event.target === dialog) close(); });
  }
</script>

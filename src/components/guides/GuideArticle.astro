---
import type { GuidePage } from "@/i18n/guides";
import { guideContent } from "@/i18n/guides";
import { localizedPath, type Locale } from "@/i18n/locales";
import { appFacts } from "@config/appFacts";
import { FaApple } from "react-icons/fa";
import GuideScreenshot from "./GuideScreenshot.astro";
import "@/styles/guide-article.css";
interface Props { guide: GuidePage; locale: Locale; }
const { guide, locale } = Astro.props;
const article = guide.article!;
const related = ["sync-videos-different-start-times", "export-split-screen-video", "video-pdf-web-multitasking"] as const;
---
<main id="main-content" class="ssp-guide-article site-shell">
  <nav class="detail-breadcrumb" aria-label="面包屑导航">
    <a href={localizedPath(locale)}>首页</a>
    <a href={localizedPath(locale, "guides")}>教程</a>
    <span aria-current="page">同时播放多个视频</span>
  </nav>
  <header class="article-guide-hero">
    <p class="eyebrow">{guide.eyebrow}</p>
    <h1>{guide.title}</h1>
    <p class="article-guide-lead">{guide.summary}</p>
    <a class="text-link" href={appFacts.appStoreUrl} target="_blank" rel="noopener noreferrer">在 App Store 免费下载</a>
  </header>
  <div class="article-guide-grid">
    <aside class="article-guide-toc">
      <p>本文目录</p>
      <nav aria-label="本文目录">
        {guide.steps.map((step, index) => <a href={`#step-${index + 1}`}><span>{String(index + 1).padStart(2, "0")}</span>{step.title}</a>)}
        <a href="#more-possibilities"><span>＋</span>更多布局与媒体支持</a>
        <a href="#questions"><span>？</span>常见问题</a>
      </nav>
    </aside>
    <article class="article-guide-body">
      <p class="article-guide-answer">{guide.answer}</p>
      {guide.steps.map((step, index) => (
        <section id={`step-${index + 1}`} class:list={["article-guide-step", index % 2 === 1 && "article-guide-step--reverse", step.image && step.image.width > step.image.height && "article-guide-step--wide"]}>
          <div class="article-guide-step-copy">
            <span class="article-guide-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h2>{step.title}</h2>
            <p>{step.description}</p>
            {step.detail && <p>{step.detail}</p>}
          </div>
          {step.image && <GuideScreenshot image={step.image} eager={index === 0} />}
        </section>
      ))}
      <section class="article-guide-more" id="more-possibilities">
        <p class="eyebrow">找到适合你的分屏方式</p>
        <h2>{article.featuresHeading}</h2>
        <p>{article.featuresIntro}</p>
        <div class="article-guide-facts" aria-label="布局与视频数量">
          <div><strong>{appFacts.layoutCount}</strong><span>种预设布局</span></div>
          <div><strong>{appFacts.maxVideos}</strong><span>个视频，最多同时播放</span></div>
          <div><strong>自由调整</strong><span>位置、大小与分割线</span></div>
        </div>
        {article.features.map(feature => <section class="article-guide-feature">
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
          {feature.link && <a class="text-link" href={localizedPath(locale, feature.link.path)}>{feature.link.label}</a>}
        </section>)}
      </section>
      <section class="article-guide-faq" id="questions">
        <h2>常见问题</h2>
        {article.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </section>
      <section class="article-guide-cta" aria-labelledby="article-download-title">
        <p class="eyebrow">Split Screen Player · 分屏播放器</p>
        <h2 id="article-download-title">{article.closingTitle}</h2>
        <p>{article.closingDescription}</p>
        <a class="button button-dark" href={appFacts.appStoreUrl} target="_blank" rel="noopener noreferrer"><FaApple aria-hidden="true" />免费下载 iPhone / iPad 版</a>
      </section>
    </article>
  </div>
  <section class="article-guide-related" aria-labelledby="related-guides-title">
    <h2 id="related-guides-title">接下来，你还可以这样用</h2>
    <div>{related.map(slug => <a href={localizedPath(locale, `guides/${slug}`)}><span>{guideContent[locale].pages[slug].eyebrow}</span><h3>{guideContent[locale].pages[slug].title}</h3><span>阅读教程 →</span></a>)}</div>
    <a class="text-link" href={localizedPath(locale, "guides")}>查看全部教程</a>
  </section>
</main>
<dialog class="article-guide-lightbox" aria-label="教程截图放大查看">
  <button type="button" class="article-guide-lightbox-close" aria-label="关闭图片">关闭 ×</button>
  <div class="article-guide-lightbox-content"></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".article-guide-lightbox");
  const content = dialog?.querySelector<HTMLElement>(".article-guide-lightbox-content");
  if (dialog && content) {
    const close = () => dialog.close();
    document.querySelectorAll<HTMLAnchorElement>("[data-guide-enlarge]").forEach(link => {
      link.addEventListener("click", event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const image = link.querySelector(".article-screenshot-image");
        if (!image) return;
        event.preventDefault();
        content.replaceChildren(image.cloneNode(true));
        dialog.showModal();
      });
    });
    dialog.querySelector("button")?.addEventListener("click", close);
    dialog.addEventListener("click", event => { if (event.target === dialog) close(); });
  }
</script>

---
import type { LanguageLink } from "@/types/content";
import { FaApple, FaBars, FaGlobe } from "react-icons/fa";

interface Props {
	name: string;
	logo: string;
	homeHref: string;
	storeHref: string;
	languageLinks: LanguageLink[];
	labels: {
		siteHeader: string;
		home: string;
		primaryNavigation: string;
		mobileNavigation: string;
	};
	nav: {
		features: string;
		useCases: string;
		guides: string;
		faq: string;
		getApp: string;
		menu: string;
	};
}

const { name, logo, homeHref, storeHref, languageLinks, labels, nav } = Astro.props;
const currentLanguage =
	languageLinks.find((link) => link.isActive)?.label ?? languageLinks[0]?.label;
const homeAnchor = (anchor: string) =>
	homeHref === "/" ? `/${anchor}` : `${homeHref}${anchor}`;
const guidesHref = homeHref === "/" ? "/guides/" : `${homeHref}guides/`;
---

<div class="site-header-wrap">
	<header class="site-header site-shell" aria-label={labels.siteHeader}>
		<a class="brand-link" href={homeHref} aria-label={`${name} — ${labels.home}`}>
			<img src={logo} width="43" height="43" alt="" />
			<span>{name}</span>
		</a>

		<nav class="primary-nav" aria-label={labels.primaryNavigation}>
			<a href={homeAnchor("#features")}>{nav.features}</a>
			<a href={homeAnchor("#use-cases")}>{nav.useCases}</a>
			<a href={guidesHref}>{nav.guides}</a>
			<a href={homeAnchor("#faq")}>{nav.faq}</a>
		</nav>

		<div class="header-actions">
			<details class="language-menu">
				<summary aria-label={currentLanguage}>{currentLanguage}</summary>
				<div class="language-popover">
					{languageLinks.map((link) => (
						<a
							href={link.href}
							hreflang={link.hrefLang}
							data-locale-choice={link.locale}
							aria-current={link.isActive ? "page" : undefined}
						>
							{link.label}
						</a>
					))}
				</div>
			</details>

			<a
				class="button button-dark button-small header-store-button"
				href={storeHref}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={nav.getApp}
			>
				<FaApple aria-hidden="true" />
				<span>{nav.getApp}</span>
			</a>

			<details class="mobile-language-menu" name="mobile-header-menu">
				<summary aria-label={currentLanguage} title={currentLanguage}>
					<FaGlobe aria-hidden="true" />
				</summary>
				<div class="language-popover mobile-language-popover">
					{languageLinks.map((link) => (
						<a
							href={link.href}
							hreflang={link.hrefLang}
							data-locale-choice={link.locale}
							aria-current={link.isActive ? "page" : undefined}
						>
							{link.label}
						</a>
					))}
				</div>
			</details>

			<details class="mobile-menu" name="mobile-header-menu">
				<summary aria-label={nav.menu} title={nav.menu}>
					<FaBars aria-hidden="true" />
				</summary>
				<nav class="mobile-popover" aria-label={labels.mobileNavigation}>
					<a href={homeAnchor("#features")}>{nav.features}</a>
					<a href={homeAnchor("#use-cases")}>{nav.useCases}</a>
					<a href={guidesHref}>{nav.guides}</a>
					<a href={homeAnchor("#faq")}>{nav.faq}</a>
					<a href={storeHref} target="_blank" rel="noopener noreferrer">{nav.getApp}</a>
				</nav>
			</details>
		</div>
	</header>
</div>

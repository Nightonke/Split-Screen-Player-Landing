---
import { getLanguageLinks, locales, type Locale } from "@/i18n/locales";
import GuideHub from "@layouts/GuideHub.astro";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== "en-US")
		.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const languageLinks = getLanguageLinks(locale, "guides");
---

<GuideHub locale={locale} languageLinks={languageLinks} />

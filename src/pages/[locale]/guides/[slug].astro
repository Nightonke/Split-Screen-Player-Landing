---
import { guideSlugs, type GuideSlug } from "@/i18n/guides";
import {
	defaultLocale,
	getLanguageLinks,
	locales,
	type Locale,
} from "@/i18n/locales";
import GuideDetail from "@layouts/GuideDetail.astro";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== defaultLocale)
		.flatMap((locale) =>
			guideSlugs.map((slug) => ({ params: { locale, slug } })),
		);
}

const { locale, slug } = Astro.params as { locale: Locale; slug: GuideSlug };
const languageLinks = getLanguageLinks(locale, `guides/${slug}`);
---

<GuideDetail locale={locale} slug={slug} languageLinks={languageLinks} />

---
import type { GuidePage } from "@/i18n/guides";
import { getGuides, getGuideLanguageLinks } from "@/i18n/guideCatalog";
import {
	defaultLocale,
	locales,
	type Locale,
} from "@/i18n/locales";
import GuideDetail from "@layouts/GuideDetail.astro";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== defaultLocale)
		.flatMap((locale) =>
			getGuides(locale).map(({ slug }) => ({ params: { locale, slug } })),
		);
}

const { locale, slug } = Astro.params as { locale: Locale; slug: GuidePage["slug"] };
const languageLinks = getGuideLanguageLinks(locale, slug);
---

<GuideDetail locale={locale} slug={slug} languageLinks={languageLinks} />

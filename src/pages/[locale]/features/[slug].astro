---
import {
	featureSlugs,
	marketingContent,
	type FeatureSlug,
} from "@/i18n/marketing";
import {
	defaultLocale,
	getLanguageLinks,
	locales,
	type Locale,
} from "@/i18n/locales";
import MarketingDetail from "@layouts/MarketingDetail.astro";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== defaultLocale)
		.flatMap((locale) =>
			featureSlugs.map((slug) => ({ params: { locale, slug } })),
		);
}

const { locale, slug } = Astro.params as {
	locale: Locale;
	slug: FeatureSlug;
};
const page = marketingContent[locale].details.features[slug];
const languageLinks = getLanguageLinks(locale, `features/${slug}`);
---

<MarketingDetail
	locale={locale}
	category="features"
	slug={slug}
	page={page}
	languageLinks={languageLinks}
/>

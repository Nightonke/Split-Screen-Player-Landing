---
import {
	marketingContent,
	type UseCaseSlug,
	useCaseSlugs,
} from "@/i18n/marketing";
import {
	defaultLocale,
	getLanguageLinks,
	locales,
	type Locale,
} from "@/i18n/locales";
import MarketingDetail from "@layouts/MarketingDetail.astro";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== defaultLocale)
		.flatMap((locale) =>
			useCaseSlugs.map((slug) => ({ params: { locale, slug } })),
		);
}

const { locale, slug } = Astro.params as {
	locale: Locale;
	slug: UseCaseSlug;
};
const page = marketingContent[locale].details.useCases[slug];
const languageLinks = getLanguageLinks(locale, `use-cases/${slug}`);
---

<MarketingDetail
	locale={locale}
	category="use-cases"
	slug={slug}
	page={page}
	languageLinks={languageLinks}
/>

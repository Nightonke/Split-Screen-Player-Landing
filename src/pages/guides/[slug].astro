---
import type { GuidePage } from "@/i18n/guides";
import { getGuides, getGuideLanguageLinks } from "@/i18n/guideCatalog";
import { defaultLocale } from "@/i18n/locales";
import GuideDetail from "@layouts/GuideDetail.astro";

export function getStaticPaths() {
	return getGuides(defaultLocale).map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: GuidePage["slug"] };
const languageLinks = getGuideLanguageLinks(defaultLocale, slug);
---

<GuideDetail locale={defaultLocale} slug={slug} languageLinks={languageLinks} />

---
import type { LanguageLink } from "@/types/content";
import type { landingContent } from "@/i18n/content";
import { mediaAsset } from "@config/media";
import { guideContent, guideSlugs } from "@/i18n/guides";
import { pageChrome } from "@/i18n/chrome";
import { localizedPath } from "@/i18n/locales";
import { marketingContent } from "@/i18n/marketing";
import { FaApple } from "react-icons/fa";
import Layout from "./Layout.astro";

type LandingContent = (typeof landingContent)[keyof typeof landingContent];

interface Props {
	content: LandingContent;
	languageLinks: LanguageLink[];
}

const { content, languageLinks } = Astro.props;
const marketing = marketingContent[content.locale];
const guides = guideContent[content.locale];
const chrome = pageChrome[content.locale];
const homeHref = localizedPath(content.locale);
const privacyHref = localizedPath(content.locale, "privacy");
const termsHref = localizedPath(content.locale, "terms");
const siteURL = Astro.site ?? new URL("https://splitscreenplayer.com");
const canonicalHome = new URL(homeHref, siteURL).href;
const storeURL = content.storeLinks.apple;
const useCaseVisuals = [
	mediaAsset("use-cases/sports-multi-view.jpg"),
	mediaAsset("use-cases/music-multi-view.jpg"),
	mediaAsset("chapters/chapter-media.jpg"),
];

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		name: "Smith Night",
		url: canonicalHome,
		logo: new URL(content.logo, siteURL).href,
		sameAs: [storeURL],
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: content.shortName,
		url: canonicalHome,
		inLanguage: content.htmlLang,
	},
	{
		"@context": "https://schema.org",
		"@type": "MobileApplication",
		name: content.name,
		description: content.metaDescription,
		url: canonicalHome,
		downloadUrl: storeURL,
		operatingSystem: "iOS 15.0 or later, iPadOS 15.0 or later",
		applicationCategory: "UtilitiesApplication",
		softwareVersion: content.version,
		image: new URL(content.logo, siteURL).href,
		screenshot: useCaseVisuals.map((src) => new URL(src, siteURL).href),
		featureList: marketing.capabilities,
		offers: {
			"@type": "Offer",
			price: 0,
			priceCurrency: "USD",
			availability: "https://schema.org/InStock",
		},
		aggregateRating: {
			"@type": "AggregateRating",
			ratingValue: content.rating.score,
			ratingCount: Number(content.rating.count),
			bestRating: 5,
			worstRating: 1,
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: content.faqs.map((item) => ({
			"@type": "Question",
			name: item.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: item.answer,
			},
		})),
	},
];
---

<Layout
	title={content.seoTitle}
	description={content.metaDescription}
	lang={content.htmlLang}
	alternates={languageLinks}
	appData={content}
	homeHref={homeHref}
	privacyHref={privacyHref}
	termsHref={termsHref}
	labels={content.labels}
	ogImageAlt={`${content.shortName} — ${marketing.hero.title.replace(/\n/g, " ")}`}
	structuredData={structuredData}
>
	<main id="main-content" class="landing-main">
		<section class="hero">
			<div class="site-shell">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">{marketing.hero.eyebrow}</p>
						<h1 class="display-title hero-title">{marketing.hero.title}</h1>
						<p class="hero-description">{marketing.hero.description}</p>
						<div class="hero-actions">
							<a
								class="button button-dark"
								href={storeURL}
								target="_blank"
								rel="noopener noreferrer"
							>
								<FaApple aria-hidden="true" />
								{marketing.hero.primaryCta}
							</a>
							<a
								class="hero-qr"
								href={storeURL}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={marketing.hero.primaryCta}
							>
								<img
									src="/assets/app-store-qr.png"
									width="72"
									height="72"
									alt=""
								/>
								<span>
									<strong>{chrome.scanWithIPhone}</strong>
									<small>{marketing.nav.getApp}</small>
								</span>
							</a>
						</div>
						<p class="hero-proof">
							<span>{marketing.hero.ratingText}</span>
							<span>{marketing.hero.privacyText}</span>
						</p>
					</div>

					<div
						id="film"
						class="film-card"
						data-reveal
					>
						<div class="film-window">
							<video
								data-hero-video
								data-video-src={content.appPreview.videoSrc}
								poster={content.appPreview.posterSrc}
								aria-label={content.appPreview.ariaLabel}
								muted
								loop
								playsinline
								preload="none"
								width="720"
								height="1564"
							></video>
						</div>
						<div class="film-meta">
							<span>{marketing.hero.soundHint}</span>
						</div>
					</div>
				</div>

			</div>
		</section>

		<div class="capability-strip" aria-label={marketing.capabilitiesLabel}>
			<div class="capability-track">
				{[0, 1].map(() => (
					<div class="capability-group" aria-hidden="true">
						<strong>{marketing.capabilitiesLabel}</strong>
						{marketing.capabilities.map((item) => <span>{item}</span>)}
					</div>
				))}
			</div>
		</div>

		<div id="features">
			{marketing.chapters.map((chapter) => (
				<section id={chapter.id} class="chapter">
					<div class="site-shell chapter-grid">
						<div class="chapter-copy" data-reveal>
							<div class="chapter-number">
								<strong>{chapter.number}</strong>
								<span>{chapter.kicker}</span>
							</div>
							<h2 class="chapter-title">{chapter.title}</h2>
							<p class="chapter-description">{chapter.description}</p>
							<ul class="chapter-points">
								{chapter.points.map((point) => <li>{point}</li>)}
							</ul>
							<a
								class="text-link chapter-link"
								href={localizedPath(content.locale, chapter.linkPath)}
							>
								{chapter.linkLabel}
							</a>
						</div>
						<div
							class:list={[
								"chapter-visual",
								{
									"chapter-video-visual": chapter.videoSrc,
									"chapter-image-visual": chapter.visualSrc,
								},
							]}
							data-reveal
						>
							{chapter.videoSrc && chapter.posterSrc ? (
								<div class="chapter-film-window">
									<video
										data-chapter-video
										data-video-src={chapter.videoSrc}
										poster={chapter.posterSrc}
										aria-label={chapter.imageAlt}
										muted
										loop
										playsinline
										preload="none"
										width="1280"
										height="590"
									></video>
								</div>
							) : chapter.visualSrc ? (
								<>
									<div class="chapter-image-window">
										<img
											src={chapter.visualSrc}
											alt={chapter.imageAlt}
											loading="lazy"
											width="720"
											height="1564"
										/>
									</div>
									{chapter.visualCaption && (
										<div class="chapter-visual-meta">
											<span>{chapter.visualCaption}</span>
										</div>
									)}
								</>
							) : (
								<img
									src={content.appPreview.posterSrc}
									alt={chapter.imageAlt}
									loading="lazy"
									width="720"
									height="1564"
								/>
							)}
						</div>
					</div>
				</section>
			))}
		</div>

		<section id="use-cases" class="section use-cases">
			<div class="site-shell">
				<div class="section-heading">
					<div>
						<p class="section-kicker">{marketing.useCases.eyebrow}</p>
						<h2 class="section-title">{marketing.useCases.title}</h2>
					</div>
					<p class="section-lede">{marketing.useCases.description}</p>
				</div>

				<div class="use-case-grid">
					{marketing.useCases.items.map((item, itemIndex) => (
						<a
							class="use-case-card"
							href={localizedPath(content.locale, `use-cases/${item.slug}`)}
							data-reveal
						>
							<div class="use-case-image">
								<img
									src={useCaseVisuals[itemIndex]}
									alt={item.title}
									loading="lazy"
									width="720"
									height="1564"
								/>
							</div>
							<div class="use-case-copy">
								<p class="section-kicker">{item.number}</p>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<span class="text-link">{item.linkLabel}</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<section id="guides" class="section guides-preview">
			<div class="site-shell">
				<div class="section-heading">
					<div>
						<p class="section-kicker">{guides.hub.eyebrow}</p>
						<h2 class="section-title">{guides.hub.title}</h2>
					</div>
					<div>
						<p class="section-lede">{guides.hub.description}</p>
						<a class="text-link guides-all-link" href={localizedPath(content.locale, "guides")}>
							{chrome.viewAllGuides}
						</a>
					</div>
				</div>

				<div class="guide-grid guide-grid--preview">
					{guideSlugs.slice(0, 4).map((slug, index) => {
						const guide = guides.pages[slug];
						return (
							<a
								class="guide-card"
								href={localizedPath(content.locale, `guides/${slug}`)}
								data-reveal
							>
								<span class="guide-card-number">{String(index + 1).padStart(2, "0")}</span>
								<p class="section-kicker">{guide.eyebrow}</p>
								<h3>{guide.title}</h3>
								<p>{guide.summary}</p>
								<span class="text-link">{guides.hub.readLabel}</span>
							</a>
						);
					})}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="site-shell">
				<div class="section-heading">
					<div>
						<p class="section-kicker">{marketing.comparison.eyebrow}</p>
						<h2 class="section-title">{marketing.comparison.title}</h2>
					</div>
				</div>

				<div
					class="comparison-wrap"
					role="region"
					aria-label={marketing.comparison.title}
					tabindex="0"
					data-reveal
				>
					<table class="comparison-table">
						<thead>
							<tr>
								{marketing.comparison.columns.map((column) => <th scope="col">{column}</th>)}
							</tr>
						</thead>
						<tbody>
							{marketing.comparison.rows.map((row) => (
								<tr>
									<th scope="row">{row.label}</th>
									{row.values.map((value) => <td>{value}</td>)}
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="comparison-note">{marketing.comparison.note}</p>
			</div>
		</section>

		<section id="faq" class="section">
			<div class="site-shell">
				<p class="section-kicker" style="text-align: center">{content.labels.faq}</p>
				<h2 class="section-title" style="margin-inline: auto; text-align: center">
					{chrome.faqHeading.split("\n").map((line, index) => (
						<>{index > 0 && <br />}{line}</>
					))}
				</h2>
				<div class="faq-list">
					{content.faqs.map((item) => (
						<details class="faq-item">
							<summary>{item.question}</summary>
							<div class="faq-answer">{item.answer}</div>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="section closing">
			<div class="site-shell closing-panel" data-reveal>
				<p class="eyebrow">{marketing.closing.eyebrow}</p>
				<h2 class="section-title">{marketing.closing.title}</h2>
				<p class="section-lede">{marketing.closing.description}</p>
				<a
					class="button button-dark"
					href={storeURL}
					target="_blank"
					rel="noopener noreferrer"
				>
					{marketing.closing.cta}
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	const beginVideoLoading = (video: HTMLVideoElement) => {
		const source = video.dataset.videoSrc;
		if (!source || video.src) return;

		video.addEventListener(
			"canplay",
			() => {
				void video.play().catch(() => {
					// The poster remains visible when autoplay is blocked.
				});
			},
			{ once: true },
		);
		video.src = source;
		video.load();
	};

	const initializeVideos = () => {
		const heroVideo =
			document.querySelector<HTMLVideoElement>("[data-hero-video]");

		if (heroVideo) {
			if ("requestIdleCallback" in window) {
				window.requestIdleCallback(() => beginVideoLoading(heroVideo), {
					timeout: 1200,
				});
			} else {
				window.setTimeout(() => beginVideoLoading(heroVideo), 250);
			}
		}

		const chapterVideos = document.querySelectorAll<HTMLVideoElement>(
			"[data-chapter-video]",
		);

		if (!("IntersectionObserver" in window)) {
			chapterVideos.forEach(beginVideoLoading);
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!(entry.target instanceof HTMLVideoElement) || !entry.isIntersecting) {
						return;
					}

					beginVideoLoading(entry.target);
					observer.unobserve(entry.target);
				});
			},
			{ rootMargin: "300px 0px" },
		);

		chapterVideos.forEach((video) => observer.observe(video));
	};

	document.readyState === "complete"
		? initializeVideos()
		: window.addEventListener("load", initializeVideos, { once: true });
</script>

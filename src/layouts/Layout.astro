---
import SiteFooter from "@/sections/SiteFooter.astro";
import SiteHeader from "@/sections/SiteHeader.astro";
import { siteConfig } from "@config/site";
import { landingContent } from "@/i18n/content";
import { pageChrome } from "@/i18n/chrome";
import { marketingContent } from "@/i18n/marketing";
import {
	defaultLocale,
	getLanguageLinks,
	localeDetectionEntries,
	localeMeta,
	locales,
	localizedPath,
	type Locale,
} from "@/i18n/locales";
import type { LayoutWithAppDataProps } from "@/types/layout";
import "@/styles/brand.css";

interface Props extends LayoutWithAppDataProps {
	ogImage?: string;
	ogImageAlt?: string;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
	noindex?: boolean;
}

const {
	title,
	description,
	appData,
	lang = "en",
	alternates = getLanguageLinks(defaultLocale),
	homeHref = localizedPath(defaultLocale),
	privacyHref = localizedPath(defaultLocale, "privacy"),
	termsHref = localizedPath(defaultLocale, "terms"),
	labels = landingContent[defaultLocale].labels,
	ogImage = "/og.png",
	ogImageAlt = "Split Screen Player — Every angle. Perfectly in sync.",
	structuredData,
	noindex = false,
} = Astro.props;

const activeLocale =
	(alternates.find((link) => link.isActive)?.locale as Locale | undefined) ??
	defaultLocale;
const marketing = marketingContent[activeLocale];
const chrome = pageChrome[activeLocale];
const navData = appData || {
	name: siteConfig.name,
	shortName: siteConfig.name,
	logo: siteConfig.logo,
	description: siteConfig.description,
	storeLinks: siteConfig.storeLinks,
};
const navTitle = navData.shortName || navData.name;
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: Astro.url;
const socialImageURL = Astro.site
	? new URL(ogImage, Astro.site).href
	: ogImage;
const xDefaultHref =
	alternates.find((alternate) => alternate.locale === defaultLocale)?.href ??
	"/";
const ogLocaleMap = Object.fromEntries(
	locales.map((locale) => [locale, localeMeta[locale].ogLocale]),
) as Record<Locale, string>;
const localizedPathPrefixes = locales
	.filter((locale) => locale !== defaultLocale)
	.map((locale) => `/${locale}`);
const jsonLd = structuredData
	? JSON.stringify(structuredData).replace(/</g, "\\u003c")
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="robots"
			content={noindex
				? "noindex, nofollow"
				: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
		/>
		<meta name="theme-color" content="#f4f1e9" />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<link rel="canonical" href={canonicalURL} />
		{alternates.map((alternate) => (
			<link
				rel="alternate"
				hreflang={alternate.hrefLang}
				href={Astro.site
					? new URL(alternate.href, Astro.site).href
					: alternate.href}
			/>
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={Astro.site ? new URL(xDefaultHref, Astro.site).href : xDefaultHref}
		/>

		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={navTitle} />
		<meta property="og:locale" content={ogLocaleMap[activeLocale]} />
		{Object.entries(ogLocaleMap)
			.filter(([locale]) => locale !== activeLocale)
			.map(([, locale]) => <meta property="og:locale:alternate" content={locale} />)}
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1536" />
		<meta property="og:image:height" content="1024" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="icon" type="image/png" href={siteConfig.logo} />
		<link rel="apple-touch-icon" href={siteConfig.logo} />
		<link rel="manifest" href="/manifest.json" />

		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<script is:inline>document.documentElement.classList.add("js");</script>
		<script
			is:inline
			define:vars={{
				activeLocale,
				defaultLocale,
				supportedLocales: locales,
				localeDetectionEntries,
				localizedPathPrefixes,
			}}
		>
			(() => {
				const storageKey = "split-screen-player-locale";
				const pathname = window.location.pathname;
				const isLocalizedPath = localizedPathPrefixes.some(
					(prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`),
				);

				if (
					activeLocale !== defaultLocale ||
					isLocalizedPath
				) {
					return;
				}

				let preferredLocale = null;
				try {
					const savedLocale = window.localStorage.getItem(storageKey);
					if (supportedLocales.includes(savedLocale)) {
						preferredLocale = savedLocale;
					}
				} catch {
					// Language detection still works when storage is unavailable.
				}

				if (!preferredLocale) {
					const deviceLanguages =
						navigator.languages?.length
							? navigator.languages
							: [navigator.language];

					for (const language of deviceLanguages) {
						const normalizedLanguage = language
							.toLowerCase()
							.replaceAll("_", "-");

						for (const [prefix, locale] of localeDetectionEntries) {
							if (
								normalizedLanguage === prefix ||
								normalizedLanguage.startsWith(`${prefix}-`)
							) {
								preferredLocale = locale;
								break;
							}
						}

						if (preferredLocale) break;
					}
				}

				if (!preferredLocale || preferredLocale === defaultLocale) {
					return;
				}

				const cleanPathname = pathname === "/index.html" ? "/" : pathname;
				const localizedPath =
					cleanPathname === "/"
						? `/${preferredLocale}/`
						: `/${preferredLocale}${cleanPathname}`;

				window.location.replace(
					`${localizedPath}${window.location.search}${window.location.hash}`,
				);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{chrome.skipToContent}</a>
		<SiteHeader
			name={navTitle}
			logo={navData.logo}
			homeHref={homeHref}
			storeHref={navData.storeLinks.apple}
			languageLinks={alternates}
			labels={{
				siteHeader: chrome.siteHeaderLabel,
				home: chrome.homeLabel,
				primaryNavigation: chrome.primaryNavigationLabel,
				mobileNavigation: chrome.mobileNavigationLabel,
			}}
			nav={marketing.nav}
		/>

		<slot />

		<SiteFooter
			name={navTitle}
			logo={navData.logo}
			tagline={marketing.footerTagline}
			homeHref={homeHref}
			privacyHref={privacyHref}
			termsHref={termsHref}
			storeHref={navData.storeLinks.apple}
			privacyLabel={labels.privacy}
			termsLabel={labels.terms}
			getAppLabel={marketing.nav.getApp}
			navigationLabel={chrome.footerNavigationLabel}
			languageLinks={alternates}
		/>

		<script is:inline>
			const localeStorageKey = "split-screen-player-locale";
			document.querySelectorAll("[data-locale-choice]").forEach((link) => {
				link.addEventListener("click", () => {
					try {
						window.localStorage.setItem(
							localeStorageKey,
							link.dataset.localeChoice,
						);
					} catch {
						// The link still works when storage is unavailable.
					}
				});
			});

			const revealItems = document.querySelectorAll("[data-reveal]");
			if ("IntersectionObserver" in window) {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								revealObserver.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
				);
				revealItems.forEach((item) => revealObserver.observe(item));
			} else {
				revealItems.forEach((item) => item.classList.add("is-visible"));
			}
		</script>
	</body>
</html>

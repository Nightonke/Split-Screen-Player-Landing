---
import { appFacts } from "@config/appFacts";
import SiteFooter from "@/sections/SiteFooter.astro";
import SiteHeader from "@/sections/SiteHeader.astro";
import { siteConfig } from "@config/site";
import { landingContent } from "@/i18n/content";
import { pageChrome } from "@/i18n/chrome";
import { getLanguageSuggestionCopy } from "@/i18n/languageSuggestion";
import { marketingContent } from "@/i18n/marketing";
import {
	defaultLocale,
	getLanguageLinks,
	localeDetectionEntries,
	localeMeta,
	locales,
	localizedPath,
	type Locale,
} from "@/i18n/locales";
import type { LayoutWithAppDataProps } from "@/types/layout";
import "@/styles/brand.css";

interface Props extends LayoutWithAppDataProps {
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: "website" | "article";
	ogImageType?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
	noindex?: boolean;
}

const {
	title,
	description,
	appData,
	lang = "en",
	alternates = getLanguageLinks(defaultLocale),
	homeHref = localizedPath(defaultLocale),
	privacyHref = localizedPath(defaultLocale, "privacy"),
	termsHref = localizedPath(defaultLocale, "terms"),
	labels = landingContent[defaultLocale].labels,
	ogImage = "/og.png",
	ogImageAlt = "Split Screen Player",
	ogType = "website",
	ogImageType = "image/png",
	ogImageWidth = 1536,
	ogImageHeight = 1024,
	structuredData,
	noindex = false,
} = Astro.props;

const activeLocale =
	(alternates.find((link) => link.isActive)?.locale as Locale | undefined) ??
	defaultLocale;
const marketing = marketingContent[activeLocale];
const chrome = pageChrome[activeLocale];
const navData = appData || {
	name: siteConfig.name,
	shortName: siteConfig.name,
	logo: siteConfig.logo,
	description: siteConfig.description,
	storeLinks: siteConfig.storeLinks,
};
const navTitle = navData.shortName || navData.name;
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: Astro.url;
const socialImageURL = Astro.site
	? new URL(ogImage, Astro.site).href
	: ogImage;
const xDefaultHref =
	alternates.find((alternate) => alternate.locale === defaultLocale)?.href ??
	alternates[0]?.href ?? "/";
const ogLocaleMap = Object.fromEntries(
	locales.map((locale) => [locale, localeMeta[locale].ogLocale]),
) as Record<Locale, string>;
const jsonLd = structuredData
	? JSON.stringify(structuredData).replace(/</g, "\\u003c")
	: undefined;
---

<!doctype html>
<html lang={lang} dir={localeMeta[activeLocale].direction}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="robots"
			content={noindex
				? "noindex, nofollow"
				: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
		/>
		<meta name="theme-color" content="#f4f1e9" />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<link rel="canonical" href={canonicalURL} />
		{alternates.map((alternate) => (
			<link
				rel="alternate"
				hreflang={alternate.hrefLang}
				href={Astro.site
					? new URL(alternate.href, Astro.site).href
					: alternate.href}
			/>
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={Astro.site ? new URL(xDefaultHref, Astro.site).href : xDefaultHref}
		/>

		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={navTitle} />
		<meta property="og:locale" content={ogLocaleMap[activeLocale]} />
		{Object.entries(ogLocaleMap)
			.filter(([locale]) => locale !== activeLocale && alternates.some(link => link.locale === locale))
			.map(([, locale]) => <meta property="og:locale:alternate" content={locale} />)}
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="icon" type="image/png" sizes="48x48" href={siteConfig.favicon} />
		<link rel="apple-touch-icon" href={siteConfig.logo} />
		<link rel="manifest" href="/manifest.json" />

		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<script is:inline>document.documentElement.classList.add("js");</script>
		<script is:inline define:vars={{
      activeLocale,
      supportedLocales: locales,
      localeDetectionEntries,
      availableAlternates: alternates.map(({ locale, href }) => ({
        locale, href,
        lang: localeMeta[locale as Locale].htmlLang,
        direction: localeMeta[locale as Locale].direction,
        ...getLanguageSuggestionCopy(locale as Locale),
      })),
    }}>
      // Suggest a language without changing the URL selected by a visitor or crawler.
      document.addEventListener("DOMContentLoaded", () => {
        let preferredLocale = null;
        try {
          const saved = localStorage.getItem("split-screen-player-locale");
          if (supportedLocales.includes(saved)) preferredLocale = saved;
        } catch {}
        if (!preferredLocale) {
          for (const language of navigator.languages?.length ? navigator.languages : [navigator.language]) {
            const normalized = language.toLowerCase().replaceAll("_", "-");
            preferredLocale = localeDetectionEntries.find(([prefix]) => normalized === prefix || normalized.startsWith(`${prefix}-`))?.[1];
            if (preferredLocale) break;
          }
        }
        if (!preferredLocale || preferredLocale === activeLocale) return;
        const target = availableAlternates.find(link => link.locale === preferredLocale);
        if (!target) return;
        const dismissalKey = "ssp-language-suggestion-dismissed";
        try {
          if (sessionStorage.getItem(dismissalKey) || sessionStorage.getItem(`ssp-language-suggestion:${activeLocale}:${preferredLocale}`)) return;
        } catch {}
        const banner = document.querySelector("[data-language-suggestion]");
        const link = banner?.querySelector("a");
        const message = banner?.querySelector("[data-language-suggestion-text]");
        const close = banner?.querySelector("button");
        if (!banner || !link || !message || !close) return;
        banner.lang = target.lang;
        banner.dir = target.direction;
        message.textContent = target.message;
        link.href = `${target.href}${location.search}${location.hash}`;
        link.textContent = target.action;
        link.hreflang = target.lang;
        link.dataset.localeChoice = target.locale;
        close.setAttribute("aria-label", target.close);
        close.title = target.close;
        banner.hidden = false;
        close.addEventListener("click", () => {
          banner.hidden = true;
          try { sessionStorage.setItem(dismissalKey, "1"); } catch {}
        });
      });
    </script>
	</head>
	<body>
    <aside class="language-suggestion" data-language-suggestion hidden>
      <div class="site-shell">
        <p><span data-language-suggestion-text></span> <a href={homeHref} data-locale-choice=""></a></p>
        <button type="button">×</button>
      </div>
    </aside>
		<a class="skip-link" href="#main-content">{chrome.skipToContent}</a>
		<SiteHeader
			name={navTitle}
			logo={navData.logo}
			homeHref={homeHref}
			storeHref={navData.storeLinks.apple}
			googlePlayHref={appFacts.googlePlayUrl}
			languageLinks={alternates}
			labels={{
				siteHeader: chrome.siteHeaderLabel,
				home: chrome.homeLabel,
				primaryNavigation: chrome.primaryNavigationLabel,
				mobileNavigation: chrome.mobileNavigationLabel,
			}}
			nav={marketing.nav}
		/>

		<slot />

		<SiteFooter
			name={navTitle}
			logo={navData.logo}
			tagline={marketing.footerTagline}
			homeHref={homeHref}
			privacyHref={privacyHref}
			termsHref={termsHref}
			storeHref={navData.storeLinks.apple}
			googlePlayHref={appFacts.googlePlayUrl}
			privacyLabel={labels.privacy}
			termsLabel={labels.terms}
			getAppLabel={marketing.nav.getApp}
			navigationLabel={chrome.footerNavigationLabel}
			languageLinks={alternates}
		/>

		<script is:inline>
			const localeStorageKey = "split-screen-player-locale";
			document.querySelectorAll("[data-locale-choice]").forEach((link) => {
				link.addEventListener("click", () => {
					try {
						window.localStorage.setItem(
							localeStorageKey,
							link.dataset.localeChoice,
						);
					} catch {
						// The link still works when storage is unavailable.
					}
				});
			});

			const revealItems = document.querySelectorAll("[data-reveal]");
			if ("IntersectionObserver" in window) {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								revealObserver.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
				);
				revealItems.forEach((item) => revealObserver.observe(item));
			} else {
				revealItems.forEach((item) => item.classList.add("is-visible"));
			}
		</script>
	</body>
</html>

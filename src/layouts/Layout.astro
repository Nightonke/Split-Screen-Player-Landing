---
import SiteFooter from "@/sections/SiteFooter.astro";
import SiteHeader from "@/sections/SiteHeader.astro";
import { siteConfig } from "@config/site";
import { landingContent } from "@/i18n/content";
import { marketingContent } from "@/i18n/marketing";
import {
	defaultLocale,
	getLanguageLinks,
	localizedPath,
	type Locale,
} from "@/i18n/locales";
import type { LayoutWithAppDataProps } from "@/types/layout";
import "@/styles/brand.css";

interface Props extends LayoutWithAppDataProps {
	ogImage?: string;
	ogImageAlt?: string;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
	noindex?: boolean;
}

const {
	title,
	description,
	appData,
	lang = "en",
	alternates = getLanguageLinks(defaultLocale),
	homeHref = localizedPath(defaultLocale),
	privacyHref = localizedPath(defaultLocale, "privacy"),
	termsHref = localizedPath(defaultLocale, "terms"),
	labels = landingContent[defaultLocale].labels,
	ogImage = "/og.png",
	ogImageAlt = "Split Screen Player — Every angle. Perfectly in sync.",
	structuredData,
	noindex = false,
} = Astro.props;

const activeLocale =
	(alternates.find((link) => link.isActive)?.locale as Locale | undefined) ??
	defaultLocale;
const marketing = marketingContent[activeLocale];
const navData = appData || {
	name: siteConfig.name,
	shortName: siteConfig.name,
	logo: siteConfig.logo,
	description: siteConfig.description,
	storeLinks: siteConfig.storeLinks,
};
const navTitle = navData.shortName || navData.name;
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: Astro.url;
const socialImageURL = Astro.site
	? new URL(ogImage, Astro.site).href
	: ogImage;
const xDefaultHref =
	alternates.find((alternate) => alternate.locale === defaultLocale)?.href ??
	"/";
const ogLocaleMap: Record<Locale, string> = {
	"en-US": "en_US",
	"zh-Hans": "zh_CN",
	"zh-Hant": "zh_TW",
};
const jsonLd = structuredData
	? JSON.stringify(structuredData).replace(/</g, "\\u003c")
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="robots"
			content={noindex
				? "noindex, nofollow"
				: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
		/>
		<meta name="theme-color" content="#f4f1e9" />
		<meta name="apple-itunes-app" content="app-id=6758291951" />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<link rel="canonical" href={canonicalURL} />
		{alternates.map((alternate) => (
			<link
				rel="alternate"
				hreflang={alternate.hrefLang}
				href={Astro.site
					? new URL(alternate.href, Astro.site).href
					: alternate.href}
			/>
		))}
		<link
			rel="alternate"
			hreflang="x-default"
			href={Astro.site ? new URL(xDefaultHref, Astro.site).href : xDefaultHref}
		/>

		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={navTitle} />
		<meta property="og:locale" content={ogLocaleMap[activeLocale]} />
		{Object.entries(ogLocaleMap)
			.filter(([locale]) => locale !== activeLocale)
			.map(([, locale]) => <meta property="og:locale:alternate" content={locale} />)}
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1536" />
		<meta property="og:image:height" content="1024" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="icon" type="image/png" href={siteConfig.logo} />
		<link rel="apple-touch-icon" href={siteConfig.logo} />
		<link rel="manifest" href="/manifest.json" />

		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader
			name={navTitle}
			logo={navData.logo}
			homeHref={homeHref}
			storeHref={navData.storeLinks.apple}
			languageLinks={alternates}
			nav={marketing.nav}
		/>

		<slot />

		<SiteFooter
			name={navTitle}
			logo={navData.logo}
			tagline={marketing.footerTagline}
			homeHref={homeHref}
			privacyHref={privacyHref}
			termsHref={termsHref}
			storeHref={navData.storeLinks.apple}
			privacyLabel={labels.privacy}
			termsLabel={labels.terms}
			getAppLabel={marketing.nav.getApp}
			languageLinks={alternates}
		/>

		<script is:inline>
			const revealItems = document.querySelectorAll("[data-reveal]");
			if ("IntersectionObserver" in window) {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								revealObserver.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
				);
				revealItems.forEach((item) => revealObserver.observe(item));
			} else {
				revealItems.forEach((item) => item.classList.add("is-visible"));
			}
		</script>
	</body>
</html>

---
import { landingContent } from "@/i18n/content";
import { pageChrome } from "@/i18n/chrome";
import { guideContent, guideSlugs, type GuideSlug } from "@/i18n/guides";
import { localizedPath, type Locale } from "@/i18n/locales";
import { marketingContent } from "@/i18n/marketing";
import type { LanguageLink } from "@/types/content";
import { mediaAsset } from "@config/media";
import { FaApple } from "react-icons/fa";
import Layout from "./Layout.astro";
import GuideArticle from "../components/guides/GuideArticle.astro";

interface Props {
	locale: Locale;
	slug: GuideSlug;
	languageLinks: LanguageLink[];
}

const { locale, slug, languageLinks } = Astro.props;
const content = landingContent[locale];
const guides = guideContent[locale];
const marketing = marketingContent[locale];
const chrome = pageChrome[locale];
const guide = guides.pages[slug];
const homeHref = localizedPath(locale);
const guidesHref = localizedPath(locale, "guides");
const pageHref = localizedPath(locale, `guides/${slug}`);
const siteURL = Astro.site ?? new URL("https://splitscreenplayer.com");
const relatedGuides = guideSlugs.filter((item) => item !== slug).slice(0, 3);
const feature = marketing.details.features[guide.relatedFeature];
const showAppPreview = slug === "play-multiple-videos-iphone-ipad" && !guide.heroImage;
const playChapter = marketing.chapters.find((chapter) => chapter.id === "play");
const reusableGuideHeroImages = {
	"sync-videos-different-start-times": "chapters/chapter-sync.jpg",
	"compare-sports-videos-frame-by-frame": "use-cases/sports-multi-view.jpg",
	"export-split-screen-video": "chapters/chapter-export.jpg",
	"video-pdf-web-multitasking": "chapters/chapter-media.jpg",
} satisfies Partial<Record<GuideSlug, string>>;
const reusableGuideHeroImage = reusableGuideHeroImages[slug as keyof typeof reusableGuideHeroImages];
const guideHeroImage = reusableGuideHeroImage
	? {
			src: mediaAsset(reusableGuideHeroImage),
			alt: guide.title,
			caption: guide.eyebrow,
		}
	: undefined;
const hasGuideHeroMedia = showAppPreview || Boolean(guideHeroImage) || Boolean(guide.heroImage);
const articleSocialImage = guide.article ? guide.steps.find(step => step.image && step.image.width > step.image.height)?.image : undefined;

const structuredData: Array<Record<string, unknown>> = [
	{
		"@context": "https://schema.org",
		"@type": "HowTo",
		name: guide.title,
		description: guide.metaDescription,
		url: new URL(pageHref, siteURL).href,
		inLanguage: content.htmlLang,
		step: guide.steps.map((step, index) => ({
			"@type": "HowToStep",
			position: index + 1,
			name: step.title,
			text: [step.description, step.detail].filter(Boolean).join(" "),
			url: new URL(`${pageHref}#step-${index + 1}`, siteURL).href,
			...(step.image ? { image: new URL(step.image.src, siteURL).href } : {}),
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: marketing.detailLabels.home,
				item: new URL(homeHref, siteURL).href,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: guides.labels.guides,
				item: new URL(guidesHref, siteURL).href,
			},
			{
				"@type": "ListItem",
				position: 3,
				name: guide.title,
				item: new URL(pageHref, siteURL).href,
			},
		],
	},
];
if (guide.article) {
	structuredData.push({
		"@context": "https://schema.org",
		"@type": "Article",
		headline: guide.title,
		description: guide.metaDescription,
		inLanguage: content.htmlLang,
		mainEntityOfPage: new URL(pageHref, siteURL).href,
		author: { "@type": "Organization", name: "Split Screen Player", url: siteURL.href },
		image: guide.steps.filter(step => step.image).map(step => new URL(step.image!.src, siteURL).href),
	}, {
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: guide.article.faq.map(item => ({
			"@type": "Question", name: item.question,
			acceptedAnswer: { "@type": "Answer", text: item.answer },
		})),
	});
}
---

<Layout
	title={guide.seoTitle}
	description={guide.metaDescription}
	lang={content.htmlLang}
	alternates={languageLinks}
	appData={content}
	homeHref={homeHref}
	privacyHref={localizedPath(locale, "privacy")}
	termsHref={localizedPath(locale, "terms")}
	labels={content.labels}
	ogImageAlt={`${content.shortName} — ${guide.title}`}
	ogType={guide.article ? "article" : "website"}
	ogImage={articleSocialImage?.src}
	ogImageType={articleSocialImage ? "image/webp" : undefined}
	ogImageWidth={articleSocialImage?.width}
	ogImageHeight={articleSocialImage?.height}
	structuredData={structuredData}
>
	{guide.article ? <GuideArticle guide={guide} locale={locale} /> : <main id="main-content" class:list={["detail-main guide-detail", guide.heroImage && "guide-detail--illustrated"]}>
		<div class="site-shell">
			<nav class="detail-breadcrumb" aria-label={chrome.breadcrumbLabel}>
				<a href={homeHref}>{marketing.detailLabels.home}</a>
				<a href={guidesHref}>{guides.labels.guides}</a>
				<span aria-current="page">{guide.eyebrow}</span>
			</nav>

			<section class:list={["guide-detail-hero", hasGuideHeroMedia && "guide-detail-hero--media"]}>
				<div class="guide-detail-copy">
					<p class="eyebrow">{guide.eyebrow}</p>
					<h1 class="display-title">{guide.title}</h1>
					<p class="detail-intro">{guide.summary}</p>
					<div class="guide-answer">
						<p class="section-kicker">{guides.labels.directAnswer}</p>
						<p>{guide.answer}</p>
					</div>
					{guide.note && <p class="guide-prerequisites">{guide.note}</p>}
				</div>

				{guide.heroImage ? (
					<figure class="guide-device-figure guide-device-figure--hero">
						<a href={guide.heroImage.src} target="_blank" rel="noopener">
							<img src={guide.heroImage.src} alt={guide.heroImage.alt} width={guide.heroImage.width} height={guide.heroImage.height} fetchpriority="high" decoding="async" />
						</a>
						<figcaption>{guide.heroImage.caption}</figcaption>
					</figure>
				) : showAppPreview ? (
					<div class="film-card guide-film-card" data-reveal>
						<div class="film-window">
							<video
								data-guide-hero-video
								data-video-src={content.appPreview.videoSrc}
								poster={content.appPreview.posterSrc}
								aria-label={content.appPreview.ariaLabel}
								muted
								loop
								playsinline
								preload="none"
								width="720"
								height="1564"
							></video>
						</div>
						<div class="film-meta">
							<span>{marketing.hero.soundHint}</span>
						</div>
					</div>
				) : guideHeroImage ? (
					<div class="film-card guide-film-card guide-film-card--image" data-reveal>
						<div class="film-window">
							<img
								class="guide-media-image"
								src={guideHeroImage.src}
								alt={guideHeroImage.alt}
								width="720"
								height="1564"
								decoding="async"
							/>
						</div>
						<div class="film-meta">
							<span>{guideHeroImage.caption}</span>
						</div>
					</div>
				) : null}
			</section>
		</div>

		<section class="detail-section feature-rich-section--1">
			<div class="site-shell">
				<div class="feature-rich-heading guide-steps-heading">
					<p class="section-kicker">{guides.labels.steps}</p>
					{showAppPreview && playChapter?.videoSrc && playChapter?.posterSrc && (
						<div class="chapter-visual chapter-video-visual guide-steps-video" data-reveal>
							<div class="chapter-film-window">
								<video
									data-guide-video
									data-video-src={playChapter.videoSrc}
									poster={playChapter.posterSrc}
									aria-label={playChapter.imageAlt}
									muted
									loop
									playsinline
									preload="none"
									width="1280"
									height="590"
								></video>
							</div>
						</div>
					)}
					<h2 class="section-title">{guide.stepsHeading ?? guide.summary}</h2>
				</div>
				<div class:list={["feature-steps", guide.heroImage && "guide-illustrated-steps"]}>
					{guide.steps.map((step, index) => (
						<article id={`step-${index + 1}`} class:list={["feature-step", step.image && "feature-step--illustrated", step.image && step.image.width > step.image.height && "feature-step--landscape"]} data-reveal>
							<span>{String(index + 1).padStart(2, "0")}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.description}</p>
							</div>
							{step.image && (
								<figure class="guide-device-figure">
									<a href={step.image.src} target="_blank" rel="noopener">
										<img src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" decoding="async" />
									</a>
									<figcaption>{step.image.caption}</figcaption>
								</figure>
							)}
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="detail-section">
			<div class="site-shell">
				<div class="feature-rich-heading">
					<p class="section-kicker">{guides.labels.tips}</p>
					<h2 class="section-title">{chrome.guideTipsHeading}</h2>
				</div>
				<div class="feature-card-grid">
					{guide.tips.map((tip, index) => (
						<article class="feature-capability-card" data-reveal>
							<span class="feature-card-number">{String(index + 1).padStart(2, "0")}</span>
							<h3>{tip.title}</h3>
							<p>{tip.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="detail-section guide-related-section">
			<div class="site-shell">
				<p class="section-kicker">{guides.labels.relatedFeature}</p>
				<div class="guide-feature-link">
					<div>
						<h2>{feature.title}</h2>
						<p>{feature.metaDescription}</p>
					</div>
					<a class="text-link" href={localizedPath(locale, `features/${guide.relatedFeature}`)}>
						{feature.kindLabel}
					</a>
				</div>

				<p class="section-kicker guide-more-label">{guides.labels.moreGuides}</p>
				<div class="detail-related">
					{relatedGuides.map((relatedSlug) => (
						<a href={localizedPath(locale, `guides/${relatedSlug}`)}>
							{guides.pages[relatedSlug].title}
						</a>
					))}
				</div>
				<a class="detail-back" href={guidesHref}>→ {guides.labels.backToGuides}</a>
			</div>
		</section>

		<section class="section closing">
			<div class="site-shell closing-panel" data-reveal>
				<p class="eyebrow">{content.shortName}</p>
				<h2 class="section-title">{chrome.guideClosingTitle}</h2>
				<p class="section-lede">{guide.summary}</p>
				<a
					class="button button-dark"
					href={content.storeLinks.apple}
					target="_blank"
					rel="noopener noreferrer"
				>
					<FaApple aria-hidden="true" />
					{chrome.downloadFree}
				</a>
			</div>
		</section>
	</main>}
</Layout>

<script>
	const beginGuideVideoLoading = (video: HTMLVideoElement) => {
		const source = video.dataset.videoSrc;
		if (!source || video.src) return;

		video.addEventListener(
			"canplay",
			() => {
				void video.play().catch(() => {
					// The poster remains visible when autoplay is blocked.
				});
			},
			{ once: true },
		);
		video.src = source;
		video.load();
	};

	const initializeGuideVideos = () => {
		const guideHeroVideo =
			document.querySelector<HTMLVideoElement>("[data-guide-hero-video]");

		if (guideHeroVideo) {
			const loadHeroVideo = () => beginGuideVideoLoading(guideHeroVideo);

			if ("requestIdleCallback" in window) {
				window.requestIdleCallback(loadHeroVideo, { timeout: 1200 });
			} else {
				window.setTimeout(loadHeroVideo, 250);
			}
		}

		const guideVideos = document.querySelectorAll<HTMLVideoElement>(
			"[data-guide-video]",
		);

		if (!("IntersectionObserver" in window)) {
			guideVideos.forEach(beginGuideVideoLoading);
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!(entry.target instanceof HTMLVideoElement) || !entry.isIntersecting) {
						return;
					}

					beginGuideVideoLoading(entry.target);
					observer.unobserve(entry.target);
				});
			},
			{ rootMargin: "300px 0px" },
		);

		guideVideos.forEach((video) => observer.observe(video));
	};

	document.readyState === "complete"
		? initializeGuideVideos()
		: window.addEventListener("load", initializeGuideVideos, { once: true });
</script>

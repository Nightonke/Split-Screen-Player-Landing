---
import { landingContent } from "@/i18n/content";
import { guideContent, guideSlugs, type GuideSlug } from "@/i18n/guides";
import { localizedPath, type Locale } from "@/i18n/locales";
import { marketingContent } from "@/i18n/marketing";
import type { LanguageLink } from "@/types/content";
import { FaApple } from "react-icons/fa";
import Layout from "./Layout.astro";

interface Props {
	locale: Locale;
	slug: GuideSlug;
	languageLinks: LanguageLink[];
}

const { locale, slug, languageLinks } = Astro.props;
const content = landingContent[locale];
const guides = guideContent[locale];
const marketing = marketingContent[locale];
const guide = guides.pages[slug];
const homeHref = localizedPath(locale);
const guidesHref = localizedPath(locale, "guides");
const pageHref = localizedPath(locale, `guides/${slug}`);
const siteURL = Astro.site ?? new URL("https://splitscreenplayer.com");
const relatedGuides = guideSlugs.filter((item) => item !== slug).slice(0, 3);
const feature = marketing.details.features[guide.relatedFeature];

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "HowTo",
		name: guide.title,
		description: guide.metaDescription,
		url: new URL(pageHref, siteURL).href,
		inLanguage: content.htmlLang,
		step: guide.steps.map((step, index) => ({
			"@type": "HowToStep",
			position: index + 1,
			name: step.title,
			text: step.description,
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: marketing.detailLabels.home,
				item: new URL(homeHref, siteURL).href,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: guides.labels.guides,
				item: new URL(guidesHref, siteURL).href,
			},
			{
				"@type": "ListItem",
				position: 3,
				name: guide.title,
				item: new URL(pageHref, siteURL).href,
			},
		],
	},
];
---

<Layout
	title={guide.seoTitle}
	description={guide.metaDescription}
	lang={content.htmlLang}
	alternates={languageLinks}
	appData={content}
	homeHref={homeHref}
	privacyHref={localizedPath(locale, "privacy")}
	termsHref={localizedPath(locale, "terms")}
	labels={content.labels}
	ogImageAlt={`${content.shortName} — ${guide.title}`}
	structuredData={structuredData}
>
	<main id="main-content" class="detail-main guide-detail">
		<div class="site-shell">
			<nav class="detail-breadcrumb" aria-label="Breadcrumb">
				<a href={homeHref}>{marketing.detailLabels.home}</a>
				<a href={guidesHref}>{guides.labels.guides}</a>
				<span aria-current="page">{guide.eyebrow}</span>
			</nav>

			<section class="guide-detail-hero">
				<p class="eyebrow">{guide.eyebrow}</p>
				<h1 class="display-title">{guide.title}</h1>
				<p class="detail-intro">{guide.summary}</p>
				<div class="guide-answer">
					<p class="section-kicker">{guides.labels.directAnswer}</p>
					<p>{guide.answer}</p>
				</div>
			</section>
		</div>

		<section class="detail-section feature-rich-section--1">
			<div class="site-shell">
				<div class="feature-rich-heading">
					<p class="section-kicker">{guides.labels.steps}</p>
					<h2 class="section-title">{guide.summary}</h2>
				</div>
				<div class="feature-steps">
					{guide.steps.map((step, index) => (
						<article class="feature-step" data-reveal>
							<span>{String(index + 1).padStart(2, "0")}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.description}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="detail-section">
			<div class="site-shell">
				<div class="feature-rich-heading">
					<p class="section-kicker">{guides.labels.tips}</p>
					<h2 class="section-title">
						{locale === "en-US"
							? "Small choices make a clearer workspace."
							: locale === "zh-Hans"
								? "几个小细节，让工作台更清楚。"
								: "幾個小細節，讓工作台更清楚。"}
					</h2>
				</div>
				<div class="feature-card-grid">
					{guide.tips.map((tip, index) => (
						<article class="feature-capability-card" data-reveal>
							<span class="feature-card-number">{String(index + 1).padStart(2, "0")}</span>
							<h3>{tip.title}</h3>
							<p>{tip.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="detail-section guide-related-section">
			<div class="site-shell">
				<p class="section-kicker">{guides.labels.relatedFeature}</p>
				<div class="guide-feature-link">
					<div>
						<h2>{feature.title}</h2>
						<p>{feature.metaDescription}</p>
					</div>
					<a class="text-link" href={localizedPath(locale, `features/${guide.relatedFeature}`)}>
						{feature.kindLabel}
					</a>
				</div>

				<p class="section-kicker guide-more-label">{guides.labels.moreGuides}</p>
				<div class="detail-related">
					{relatedGuides.map((relatedSlug) => (
						<a href={localizedPath(locale, `guides/${relatedSlug}`)}>
							{guides.pages[relatedSlug].title}
						</a>
					))}
				</div>
				<a class="detail-back" href={guidesHref}>→ {guides.labels.backToGuides}</a>
			</div>
		</section>

		<section class="section closing">
			<div class="site-shell closing-panel" data-reveal>
				<p class="eyebrow">{content.shortName}</p>
				<h2 class="section-title">
					{locale === "en-US"
						? "Try the complete workflow on your own videos."
						: locale === "zh-Hans"
							? "用你自己的视频，体验完整工作流。"
							: "用你自己的影片，體驗完整工作流程。"}
				</h2>
				<p class="section-lede">{guide.summary}</p>
				<a
					class="button button-dark"
					href={content.storeLinks.apple}
					target="_blank"
					rel="noopener noreferrer"
				>
					<FaApple aria-hidden="true" />
					{locale === "en-US" ? "Download free" : locale === "zh-Hans" ? "免费下载" : "免費下載"}
				</a>
			</div>
		</section>
	</main>
</Layout>
